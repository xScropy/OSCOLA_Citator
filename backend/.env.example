# Database. SQLite by default; for PostgreSQL / Supabase use the connection string, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
DATABASE_URL=sqlite:///./citeright.db

# Signs access tokens. REQUIRED in production: without it a random key is generated at
# start-up and every user is signed out whenever the server restarts.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Only needed if the browser calls the API directly instead of through the Next.js proxy.
CORS_ORIGINS=http://localhost:3000

# Optional metadata-provider settings. Keys stay on the backend.
GOOGLE_BOOKS_API_KEY=
CROSSREF_MAILTO=
COURTLISTENER_TOKEN=
